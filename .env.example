# ================================================================
# CARD SHOP - Environment Variables
# ================================================================
#
# Variáveis de ambiente para a aplicação Card Shop
#
# IMPORTANTE:
# 1. Copie este arquivo para .env para desenvolvimento local
# 2. Substitua os valores pelos valores reais
# 3. NUNCA commite o arquivo .env no Git
# ================================================================

# ----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cardshop
DB_USER=cardshop
DB_PASSWORD=cardshop

# ----------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ================================================================
# AMBIENTES
# ================================================================
#
# DESENVOLVIMENTO LOCAL (docker-compose):
#   DB_HOST=localhost
#   DB_PASSWORD=cardshop
#
# STAGING:
#   DB_HOST=postgres-staging.example.com
#   DB_PASSWORD=${STAGING_DB_PASSWORD}  # GitHub Secret
#
# PRODUCTION:
#   DB_HOST=postgres-prod.example.com
#   DB_PASSWORD=${PROD_DB_PASSWORD}     # GitHub Secret
#
# ================================================================
# CONFIGURAÇÃO DE SECRETS
# ================================================================
#
# GitHub Secrets necessários:
#
# 1. STAGING_DB_PASSWORD
#    - Senha do PostgreSQL em staging
#    - Gerar: openssl rand -base64 32
#
# 2. PROD_DB_PASSWORD
#    - Senha do PostgreSQL em produção
#    - Gerar: openssl rand -base64 32
#
# Como configurar:
#   GitHub → Settings → Secrets and variables → Actions
#   New repository secret
#
# ================================================================
# KUBERNETES
# ================================================================
#
# Variáveis (ConfigMap):
#   DB_HOST: postgres-service
#   DB_PORT: 5432
#   DB_NAME: cardshop
#   DB_USER: cardshop
#
# Secrets (Kubernetes Secret):
#   DB_PASSWORD: [from secret]
#
# ================================================================

